from google.colab import files
from PIL import Image, ImageOps
import numpy as np
import matplotlib.pyplot as plt
import tensorflow as tf
from tensorflow.keras import layers, models

#Load MNIST Dataset
(x_train, y_train), (x_test, y_test) = tf.keras.datasets.mnist.load_data()
x_train = x_train / 255.0
x_test = x_test / 255.0

#Build Model
model = models.Sequential([
    layers.Flatten(input_shape=(28, 28)),
    layers.Dense(128, activation='relu'),
    layers.Dense(10, activation='softmax')
])

model.compile(optimizer='adam', loss='sparse_categorical_crossentropy', metrics=['accuracy'])

#Train the Model
model.fit(x_train, y_train, epochs=3)

#Upload Two-Digit Image
print("Upload your two-digit image (example: 45, 78, 23)")
uploaded = files.upload()
image_name = list(uploaded.keys())[0]

#Preprocess Image
img = Image.open(image_name).convert("L")   # Convert to grayscale2A
img = ImageOps.invert(img)                  # Invert colors if needed
img = img.resize((56, 28))                  # Resize to double width for 2 digits

img_array = np.array(img)
img_array = img_array / 255.0               # Normalize pixel values

#Split Image into Two Digits
digit1 = img_array[:, :28].reshape(1, 28, 28)
digit2 = img_array[:, 28:].reshape(1, 28, 28)

#Predict Each Digit
pred1 = np.argmax(model.predict(digit1))
pred2 = np.argmax(model.predict(digit2))

#Combine Predictions
two_digit_number = str(pred1) + str(pred2)

#Display Result
plt.imshow(img_array, cmap='gray')
plt.title(f"Predicted Two-Digit Number: {two_digit_number}")
plt.axis('off')
plt.show()

print("Predicted two-digit number is:", two_digit_number)
