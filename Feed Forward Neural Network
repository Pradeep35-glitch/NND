        "2. #implement the feed forward neural network using  numpy with class\n",
        "\n",
        "\n",
        "\n",
        "import numpy as np\n",
        "\n",
        "class FeedForwardNeuralNetwork:\n",
        "\n",
        "    def __init__(self, input_size, hidden_size, output_size, lr=0.1):\n",
        "        self.lr = lr\n",
        "        self.W1 = np.random.randn(input_size, hidden_size)\n",
        "        self.b1 = np.zeros((1, hidden_size))\n",
        "        self.W2 = np.random.randn(hidden_size, output_size)\n",
        "        self.b2 = np.zeros((1, output_size))\n",
        "\n",
        "    def sigmoid(self, x):\n",
        "        return 1 / (1 + np.exp(-x))\n",
        "\n",
        "    def sigmoid_derivative(self, x):\n",
        "        return x * (1 - x)\n",
        "\n",
        "    def forward(self, x):\n",
        "        self.z1 = np.dot(x, self.W1) + self.b1\n",
        "        self.a1 = self.sigmoid(self.z1)\n",
        "        self.z2 = np.dot(self.a1, self.W2) + self.b2\n",
        "        self.y_pred = self.sigmoid(self.z2)\n",
        "        return self.y_pred\n",
        "\n",
        "    def compute_loss(self, y, y_pred):\n",
        "        return np.mean((y - y_pred) ** 2)\n",
        "\n",
        "    def backward(self, x, y):\n",
        "        error = y - self.y_pred\n",
        "        d_output = error * self.sigmoid_derivative(self.y_pred)\n",
        "        dW2 = np.dot(self.a1.T, d_output)\n",
        "        db2 = np.sum(d_output, axis=0, keepdims=True)\n",
        "        d_hidden = np.dot(d_output, self.W2.T) * self.sigmoid_derivative(self.a1)\n",
        "        dW1 = np.dot(x.T, d_hidden)\n",
        "        db1 = np.sum(d_hidden, axis=0, keepdims=True)\n",
        "        self.W2 += self.lr * dW2\n",
        "        self.b2 += self.lr * db2\n",
        "        self.W1 += self.lr * dW1\n",
        "        self.b1 += self.lr * db1\n",
        "\n",
        "    def train(self, x, y, epochs=1000):\n",
        "        for _ in range(epochs):\n",
        "            self.forward(x)\n",
        "            self.backward(x, y)\n",
        "        # Return single value (average of all predictions)\n",
        "        return np.mean(self.y_pred)\n",
        "\n",
        "\n",
        "X = np.array([[0, 0],\n",
        "              [0, 1],\n",
        "              [1, 0],\n",
        "              [1, 1]])\n",
        "\n",
        "y = np.array([[0],\n",
        "              [1],\n",
        "              [1],\n",
        "              [0]])\n",
        "\n",
        "model = FeedForwardNeuralNetwork(2, 2, 1)\n",
        "final_output = model.train(X, y, epochs=1000)\n",
        "\n",
        "print(\"Final Output (single value):\", round(final_output, 3))\n"
